[Unit]
Description=MAAT ETC - Flask app served by Gunicorn
After=network.target

[Service]
User=vagrant
Group=www-data
WorkingDirectory=/var/www/MAATETC
Environment="PATH=/var/www/MAATETC/venv/bin"
ExecStart=/var/www/MAATETC/venv/bin/gunicorn --workers 4 --bind unix:/var/www/MAATETC/app.sock -m 007 wsgi:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
